{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "GleamDesk",
  "mainBinaryName": "GleamDesk",
  "version": "0.1.2",
  "identifier": "org.agentroom.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420/main.html",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "GleamDesk",
        "visible": false,
        "url": "main.html",
        "width": 1920,
        "height": 1080,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "resizable": false,
        "skipTaskbar": true
      },
      {
        "label": "dock",
        "title": "GleamDesk · Dock",
        "url": "dock.html",
        "width": 64,
        "height": 64,
        "visible": false,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "resizable": false,
        "skipTaskbar": true,
        "alwaysOnTop": false,
        "focusable": false,
        "focus": false
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; connect-src ipc: http://ipc.localhost http://127.0.0.1:1420 ws://127.0.0.1:1420; img-src 'self' asset: http://asset.localhost data: blob:; style-src 'self' 'unsafe-inline';"
    }
  },
  "bundle": {
    "active": true,
    "publisher": "GleamDesk contributors",
    "licenseFile": "../LICENSE",
    "resources": {
      "../LICENSE": "LICENSE",
      "../licenses/vps-services": "licenses/vps-services",
      "../licenses/updater": "licenses/updater",
      "../docs/licenses": "licenses/hud",
      "../src/assets/hud/LobeIcons-LICENSE.txt": "licenses/LobeIcons-LICENSE.txt",
      "../vendor/wry/LICENSE-APACHE": "licenses/wry/LICENSE-APACHE",
      "../vendor/wry/LICENSE-MIT": "licenses/wry/LICENSE-MIT"
    },
    "icon": [
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "targets": [
      "nsis"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "English",
          "SimpChinese"
        ],
        "displayLanguageSelector": true
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDA2MUE3MDM1ODBERTIxRTIKUldUaUlkNkFOWEFhQnJzZkxBcHkwdUNtUnZTM2tUN1RORU9teUtvOC8xRllsQWE2V2hNeTBJWTYK",
      "requireSignedVersion": true,
      "allowDowngrades": false,
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
